# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=1d

# Database (set DB_TYPE=memory to disable external DB)
# DB_TYPE=mysql          # mysql | postgres | memory
# DB_HOST=localhost
# DB_PORT=3306           # postgres default: 5432
# DB_NAME=ecommerce
# DB_USER=root
# DB_PASSWORD=your_password
# DB_TABLE=app_records
# DB_SSL=false

# Redis (cache + queue)
# REDIS_ENABLED=true
# REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TTL_SECONDS=300

# Queue (requires Redis to be useful in multi-instance deployment)
# QUEUE_ENABLED=true
# QUEUE_ORDER_KEY=queue:orders
# QUEUE_LOG_KEY=queue:logs
# QUEUE_POLL_MS=1000

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate limiting (optional — shown with defaults)
# RATE_API_WINDOW_MS=60000        # General API window: 1 minute
# RATE_API_MAX=300                # Max requests per IP per window
# RATE_WRITE_WINDOW_MS=60000      # Write-op window: 1 minute
# RATE_WRITE_MAX=30               # Max write ops per IP per window
# RATE_AUTH_WINDOW_MS=900000      # Auth window: 15 minutes
# RATE_AUTH_MAX=10                # Max login/register attempts per IP per window
